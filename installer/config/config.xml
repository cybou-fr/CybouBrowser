<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>CYBOU</Name>
    <Version>0.4.0-alpha.1</Version>
    <Title>CYBOU Browser</Title>
    <Publisher>CYBOU</Publisher>
    <ProductUrl>https://github.com/</ProductUrl>
    <StartMenuDir>CYBOU</StartMenuDir>
    <!-- One folder per release: see packages/org.cybou.browser/meta/installscript.qs -->
    <TargetDir>@HomeDir@/AppData/Local/Programs/CYBOU-@ProductVersion@</TargetDir>
    <MaintenanceToolName>CYBOUUninstall</MaintenanceToolName>
    <RemoveTargetDir>true</RemoveTargetDir>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <WizardStyle>Modern</WizardStyle>
    <InstallerApplicationIcon>../../assets/cybou</InstallerApplicationIcon>
    <InstallerWindowIcon>../../assets/cybou.png</InstallerWindowIcon>
</Installer>
