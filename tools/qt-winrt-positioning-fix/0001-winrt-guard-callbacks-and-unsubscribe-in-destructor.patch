+// WinRT calls the registered handlers on its own threads and may still be inside one when the source
+// is destroyed. The handlers therefore hold this shared object instead of a raw pointer to the source:
+// the destructor clears `owner`, waits (bounded) for a handler that is already running, and handlers that
+// start later find no owner and return.
+struct WinRTCallbackGuard {
+    std::atomic<bool> alive { true };
+    std::atomic<QGeoPositionInfoSourceWinRT *> owner { nullptr };
+    QMutex mutex; // held while a handler uses `owner`
+};
+
 class QGeoPositionInfoSourceWinRTPrivate {
 public:
+    std::shared_ptr<WinRTCallbackGuard> guard = std::make_shared<WinRTCallbackGuard>();
     ComPtr<IGeolocator> locator;
     mutable ComPtr<IGeolocatorStatics> statics;
     QTimer periodicTimer;
@@ -98,11 +110,24 @@ QGeoPositionInfoSourceWinRT::QGeoPositionInfoSourceWinRT(QObject *parent)
     d->updatesOngoing = false;
     d->positionToken.value = 0;
     d->statusToken.value = 0;
+    d->guard->owner.store(this);
 }
 
 QGeoPositionInfoSourceWinRT::~QGeoPositionInfoSourceWinRT()
 {
     qCDebug(lcPositioningWinRT) << __FUNCTION__;
+    Q_D(QGeoPositionInfoSourceWinRT);
+
+    // 1. New handler invocations must find no owner. 2. A handler that is already running holds the mutex:
+    // wait for it, bounded so that a handler blocked on this (apartment) thread cannot deadlock the destructor.
+    d->guard->alive.store(false);
+    d->guard->owner.store(nullptr);
+    if (d->guard->mutex.tryLock(2000))
+        d->guard->mutex.unlock();
+    else
+        qCWarning(lcPositioningWinRT) << "WinRT position handler still running while the source is destroyed";
+    // 3. Unsubscribe, as stopUpdates() does; previously the destructor left both handlers registered.
+    stopHandler();
     CoUninitialize();
 }
 
